# This app is a fully static Next.js export (`output: "export"`) served from
# GitHub Pages. There is no server runtime and no remote AI service.

# Optional. Path prefix used by the static export when hosted under a subpath
# (e.g. "/LevelUp" on GitHub Pages). Defaults to "".
# NEXT_PUBLIC_BASE_PATH="/LevelUp"

# Not used: legacy cloud-AI credentials, APP_URL, or any remote AI URL.
# This codebase contains no server-side AI calls, no OAuth callbacks, and no
# self-referential API endpoints. Anything you see here reflects what the code
# actually reads.

# Optional. GA4 measurement ID (e.g. "G-XXXXXXXXXX"). When set, the site
# bootstraps gtag and fires page_view plus whitelisted interaction events
# (chapters opened/completed, quizzes, protocol runs, searches, highlights,
# backups). When unset or empty, analytics stays dormant — no gtag script is
# injected and no network requests are made. This is a public value shipped
# inside the static bundle; nothing secret.
# NEXT_PUBLIC_GA_ID=""

# Optional development override for the Ollama HTTP endpoint on the same
# computer. The app rejects non-loopback hosts and always locks the model to
# llama3.1:latest. Leave empty to use the default below.
# NEXT_PUBLIC_LEVELUP_OLLAMA_URL="http://127.0.0.1:11434/api/chat"
