# This app is a fully static Next.js export (`output: "export"`) served from
# GitHub Pages. There is no server runtime, so no API keys, secrets, or URLs
# are required at build time or runtime.

# Optional. Path prefix used by the static export when hosted under a subpath
# (e.g. "/LevelUp" on GitHub Pages). Defaults to "".
# NEXT_PUBLIC_BASE_PATH="/LevelUp"

# Not used: GEMINI_API_KEY, APP_URL. This codebase contains no server-side
# Gemini calls, no OAuth callbacks, and no self-referential API endpoints —
# those variables belonged to the old AI Studio applet scaffolding and were
# removed. Anything you see here reflects what the code actually reads.

# Optional. GA4 measurement ID (e.g. "G-XXXXXXXXXX"). When set, the site
# bootstraps gtag and fires page_view plus whitelisted interaction events
# (chapters opened/completed, quizzes, protocol runs, searches, highlights,
# backups). When unset or empty, analytics stays dormant — no gtag script is
# injected and no network requests are made. This is a public value shipped
# inside the static bundle; nothing secret.
# NEXT_PUBLIC_GA_ID=""

# Optional. Public URL for a separately deployed LevelUp AI endpoint. This is
# safe to expose because it is only an endpoint address, not a credential. The
# GitHub Pages static export does not host this POST endpoint. When it is empty
# or unavailable, Study Mode uses its deterministic local Coach, Planner, and
# Tutor fallback.
# NEXT_PUBLIC_LEVELUP_AI_ENDPOINT=""

# Server-only variables for the future endpoint (never add these to the static
# site or prefix them with NEXT_PUBLIC_):
# OPENAI_API_KEY=""
# LEVELUP_AI_MODEL="gpt-4o-mini"
